{
  "name": "dixti",
  "version": "0.1.0",
  "description": "A shared store of notes, written by agents, living inside a project's own git repository.",
  "type": "module",
  "bin": {
    "dixti": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "rm -rf dist && tsc && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run check-private && npm run typecheck && npm test && npm run build",
    "dict": "node dist/cli.js dict .",
    "check-private": "bash scripts/check-private.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "agent",
    "memory",
    "notes",
    "git",
    "ai",
    "claude",
    "knowledge-base"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brayton19/dixti.git"
  },
  "homepage": "https://github.com/Brayton19/dixti#readme",
  "bugs": {
    "url": "https://github.com/Brayton19/dixti/issues"
  },
  "files": [
    "dist",
    "hooks",
    "spec",
    "README.md",
    "LICENSE"
  ]
}
